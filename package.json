{
  "name": "vnr202-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime backend for the VNR202 N07 gallery game (4 decision points, guess-the-class scoring, reflection wall)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:stage",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "dev:stage": "vite --config stage/vite.config.ts",
    "build:stage": "tsc -p stage/tsconfig.json && node scripts/clean-stage.js && vite build --config stage/vite.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "gsap": "^3.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vite": "^8.3.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ]
  }
}
