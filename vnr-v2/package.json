{
  "name": "vnr202-co-ngua-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/engine.test.ts",
    "backend:build": "tsc -p backend/tsconfig.json && node -e \"require('fs').writeFileSync('dist-backend/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "backend:start": "node dist-backend/backend/src/main.js",
    "backend:dev": "tsc -p backend/tsconfig.json && node --watch dist-backend/backend/src/main.js",
    "build:all": "npm run backend:build && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.2"
  }
}
